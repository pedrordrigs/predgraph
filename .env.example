# Storage. SQLite by default. For the cloud deployment (see docs/deploy.md) set
# this to the hosted Postgres DSN; a provider's `postgres://` or `postgresql://`
# string can be pasted unedited - the driver is pinned for you.
PREDGRAPH_DB_URL=sqlite:///data/predgraph.db

# Deployed dashboard only. When set, every route needs ?k=<token>. Leave unset
# locally. This is a shared secret to keep strangers out of the numbers, not an
# auth system.
# PREDGRAPH_DASHBOARD_TOKEN=

# DNS override: the Brazilian ISP resolver NXDOMAINs polymarket.com / kalshi domains.
# These resolvers answer normally and the APIs serve read-only data without geo-blocking.
PREDGRAPH_DNS_SERVERS=1.1.1.1,8.8.8.8

# Only hostnames matching these suffixes bypass the system resolver.
PREDGRAPH_DNS_OVERRIDE_SUFFIXES=polymarket.com,kalshi.com,kalshi.co

PREDGRAPH_HTTP_TIMEOUT=20
PREDGRAPH_LOG_LEVEL=INFO
